# We want to include the THIRD_PARTY_LICENSES.md file in the Docker image,
# but not other .md files except README-COOLIFY.md
**/*.md
!**/THIRD_PARTY_LICENSES.md
!README-COOLIFY.md
**/.env
**/.env.*
!.env.example
.cache
assets
node_modules
packages/node-dev
packages/**/node_modules
packages/**/dist
packages/**/.turbo
packages/**/*.test.*
.git
.github
!.github/scripts
*.tsbuildinfo
docker/compose
docker/**/Dockerfile
.vscode
packages/testing
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage
.nyc_output
.DS_Store
Thumbs.db
tmp
temp
.tmp
.temp
*.swp
*.swo
*~