# ============================================================================
# n8n Environment Configuration for Coolify Deployment
# ============================================================================
# Copy this file to .env and fill in your values
# Required variables are marked with (REQUIRED)
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL database name
POSTGRES_DB=n8n

# PostgreSQL username
POSTGRES_USER=n8n

# PostgreSQL password (REQUIRED)
POSTGRES_PASSWORD=change_this_secure_password

# PostgreSQL non-root user (optional, defaults to n8n)
POSTGRES_NON_ROOT_USER=n8n

# PostgreSQL non-root password (optional, defaults to POSTGRES_PASSWORD if not set)
# If not specified, will use the main POSTGRES_PASSWORD value
POSTGRES_NON_ROOT_PASSWORD=

# ----------------------------------------------------------------------------
# n8n Core Configuration
# ----------------------------------------------------------------------------
# Port where n8n will be accessible (default: 5678)
N8N_PORT=5678

# Host binding (default: 0.0.0.0)
N8N_HOST=0.0.0.0

# Protocol (http or https)
N8N_PROTOCOL=https

# Full webhook URL - IMPORTANT: Set this to your actual domain
# Example: https://n8n.yourdomain.com/
WEBHOOK_URL=https://your-n8n-domain.com/

# Editor base URL (optional, useful for custom domains)
N8N_EDITOR_BASE_URL=

# Encryption key for credentials (REQUIRED)
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=change_this_to_random_32_char_string

# ----------------------------------------------------------------------------
# Basic Authentication (Optional)
# ----------------------------------------------------------------------------
# Enable basic auth for additional security
N8N_BASIC_AUTH_ACTIVE=false

# Basic auth username (if enabled)
N8N_BASIC_AUTH_USER=

# Basic auth password (if enabled)
N8N_BASIC_AUTH_PASSWORD=

# ----------------------------------------------------------------------------
# Timezone Configuration
# ----------------------------------------------------------------------------
# Generic timezone setting
GENERIC_TIMEZONE=UTC

# System timezone
TZ=UTC

# ----------------------------------------------------------------------------
# Execution Configuration
# ----------------------------------------------------------------------------
# Execution mode: regular or queue
EXECUTIONS_MODE=regular

# ----------------------------------------------------------------------------
# Diagnostics & Telemetry
# ----------------------------------------------------------------------------
# Enable diagnostics (set to false for privacy)
N8N_DIAGNOSTICS_ENABLED=true

# Enable personalization
N8N_PERSONALIZATION_ENABLED=true

# ----------------------------------------------------------------------------
# External Secrets (Optional)
# ----------------------------------------------------------------------------
# Update interval for external secrets (in seconds)
N8N_EXTERNAL_SECRETS_UPDATE_INTERVAL=300

# ----------------------------------------------------------------------------
# Node.js Function Security (Optional)
# ----------------------------------------------------------------------------
# Allow specific built-in modules (comma-separated)
NODE_FUNCTION_ALLOW_BUILTIN=

# Allow external npm modules (comma-separated)
NODE_FUNCTION_ALLOW_EXTERNAL=

# ----------------------------------------------------------------------------
# Queue Mode with Redis (Optional - for scaling)
# ----------------------------------------------------------------------------
# Uncomment these if you enable Redis for queue mode
# QUEUE_BULL_REDIS_HOST=redis
# QUEUE_BULL_REDIS_PORT=6379
# QUEUE_BULL_REDIS_DB=0
# QUEUE_BULL_REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Email Configuration (Optional)
# ----------------------------------------------------------------------------
# Email mode: smtp or sendgrid
N8N_EMAIL_MODE=

# SMTP configuration
N8N_SMTP_HOST=
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
N8N_SMTP_SENDER=

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: error, warn, info, verbose, debug
N8N_LOG_LEVEL=info

# Log output: console, file
N8N_LOG_OUTPUT=console

# ----------------------------------------------------------------------------
# Metrics (Optional)
# ----------------------------------------------------------------------------
# Enable Prometheus metrics
N8N_METRICS=false

# Metrics prefix
N8N_METRICS_PREFIX=n8n_

# ----------------------------------------------------------------------------
# Build Configuration (Optional)
# ----------------------------------------------------------------------------
# Node.js version for Docker build
NODE_VERSION=22.21.0

# n8n version
N8N_VERSION=latest

# Release type
N8N_RELEASE_TYPE=stable

# ============================================================================
# IMPORTANT NOTES FOR COOLIFY DEPLOYMENT:
# ============================================================================
# 1. POSTGRES_PASSWORD and N8N_ENCRYPTION_KEY are REQUIRED
# 2. Set WEBHOOK_URL to your actual Coolify domain
# 3. Use N8N_PROTOCOL=https if using Coolify's SSL
# 4. Generate strong passwords and keys for production
# 5. Consider enabling basic auth for additional security
# 6. For scaling, uncomment Redis configuration and enable queue mode
# ============================================================================
