# ============================================================================
# Coolify n8n Deployment - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the required values
# DO NOT commit the .env file with actual secrets to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Required)
# ============================================================================
# PostgreSQL database credentials
# IMPORTANT: Use strong, unique passwords in production
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
POSTGRES_DB=n8n

# ============================================================================
# N8N HOST AND URL CONFIGURATION (Required)
# ============================================================================
# Your domain name or IP address where n8n will be accessible
# Example: n8n.yourdomain.com or workflow.company.com
N8N_HOST=your-domain.com

# Protocol for n8n - use https in production with SSL/TLS
# Values: http or https
N8N_PROTOCOL=https

# Complete webhook URL - this is how external services will reach your webhooks
# Format: https://your-domain.com or http://your-ip-address:5678
# This MUST match your actual public URL
WEBHOOK_URL=https://your-domain.com

# ============================================================================
# ENCRYPTION KEY (Required - CRITICAL SECURITY)
# ============================================================================
# Used to encrypt credentials in the database
# IMPORTANT: 
# - Generate a strong random string (at least 32 characters)
# - Once set, DO NOT CHANGE this value or you'll lose access to encrypted credentials
# - Keep this secret safe and never share it
# 
# Generate a secure key using one of these commands:
# - openssl rand -hex 32
# - node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
N8N_ENCRYPTION_KEY=GENERATE_A_SECURE_RANDOM_STRING_HERE

# ============================================================================
# BASIC AUTHENTICATION (Optional but Recommended)
# ============================================================================
# Enable basic authentication to protect your n8n instance
# Set to false if you're using another authentication method (OAuth, SSO, etc.)
N8N_BASIC_AUTH_ACTIVE=true

# Basic auth credentials
# IMPORTANT: Change these to strong, unique credentials
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ============================================================================
# TIMEZONE CONFIGURATION (Optional)
# ============================================================================
# Set your timezone for correct time handling in workflows
# Use timezone identifiers from: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, Europe/London, Asia/Tokyo, UTC
GENERIC_TIMEZONE=UTC
TZ=UTC

# ============================================================================
# EXECUTION DATA CONFIGURATION (Optional)
# ============================================================================
# Controls what execution data is saved to the database
# Values: all, none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ============================================================================
# LOGGING CONFIGURATION (Optional)
# ============================================================================
# Log level: debug, info, warn, error
N8N_LOG_LEVEL=info

# Where to send logs: console, file
N8N_LOG_OUTPUT=console

# ============================================================================
# DIAGNOSTICS (Optional)
# ============================================================================
# Send anonymous usage data to n8n to help improve the product
# Set to false if you prefer not to share diagnostics
N8N_DIAGNOSTICS_ENABLED=false

# ============================================================================
# EMAIL/SMTP CONFIGURATION (Optional - Uncomment to enable)
# ============================================================================
# Configure these if you want n8n to send emails (for password resets, etc.)
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your-email@gmail.com
# N8N_SMTP_PASS=your-app-specific-password
# N8N_SMTP_SENDER=your-email@gmail.com
# N8N_SMTP_SSL=true

# ============================================================================
# ADDITIONAL OPTIONAL CONFIGURATIONS
# ============================================================================

# Maximum payload size (in MB)
# N8N_PAYLOAD_SIZE_MAX=16

# Default user name for new accounts (when not using basic auth)
# N8N_OWNER_EMAIL=owner@example.com

# Enable/disable user management features
# N8N_USER_MANAGEMENT_DISABLED=false

# Custom nodes directory (advanced users only)
# N8N_CUSTOM_EXTENSIONS=/home/node/.n8n/custom

# Community nodes installation (enable to install community nodes)
# N8N_COMMUNITY_PACKAGES_ENABLED=true

# ============================================================================
# NOTES
# ============================================================================
# 1. After copying this file to .env, update all values marked with CHANGE_THIS
# 2. Generate secure random strings for passwords and encryption keys
# 3. Ensure your domain/URL is correctly configured before starting
# 4. Keep your .env file secure and never commit it to version control
# 5. Restart the containers after changing environment variables
